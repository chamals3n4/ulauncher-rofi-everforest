/* Everforest palette */
@define-color bg      #2f383e;
@define-color bg_alt  #374247;
@define-color fg      #d3c6aa;
@define-color green   #a7c080;

window, .main {
  background-color: transparent;
}

/* top band = input color, so the gap around the input disappears visually */
.app {
  background-color: @bg_alt;
  border: none;
  border-radius: 0;
  margin: 0;
  padding: 0;
  box-shadow: none;
}

.input {
  background-color: transparent;
  color: @green;
  caret-color: @fg;
  font-family: "Fira Mono", "JetBrains Mono", monospace;
  font-size: 16px;
  border: none;
  border-radius: 0;
  box-shadow: none;
  padding: 0;
  margin: 0;
}

.result-box {
  background-color: @bg;
  padding: 0;
  margin: 0;
}

.item-box {
  padding: 0 10px;
  margin: 0;
  border-radius: 0;
  background-color: @bg;
}

/* draw icons smaller, like rofi */
.item-box image {
  -gtk-icon-transform: scale(0.55);
}

.item-name {
  color: @fg;
  font-family: "Fira Mono", "JetBrains Mono", monospace;
  font-size: 16px;
  margin: 0;
  padding: 0;
}

/* collapse the description so the name sits in the middle */
.item-descr {
  font-size: 0.1px;
  color: transparent;
  margin: 0;
  padding: 0;
  min-height: 0;
}

.item-shortcut {
  color: transparent;
  font-size: 0.1px;
}

.selected.item-box {
  background-color: @green;
}
.selected.item-box .item-name {
  color: @bg;
}

.prefs-btn {
  opacity: 0;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
}
